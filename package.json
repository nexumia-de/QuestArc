    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^27.2.0",
    "lightningcss": "^1.30.2",
    "prettier": "^3.6.2",
    "solid-js": "^1.9.10",
    "standard-version": "^9.5.0",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
