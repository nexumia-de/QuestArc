{
  "id": "quest-arc",
  "name": "QuestArc",
  "version": "1.0.1",
  "manifestVersion": 1,
  "minSupVersion": "8.0.0",
  "description": "Gamify your productivity with epic stories and boss battles.",
  "author": "QuestArc Team",
  "homepage": "https://github.com/questarc/quest-arc",
  "repository": {
    "type": "git",
    "url": "https://github.com/questarc/quest-arc.git"
  },
  "permissions": ["showSnack", "persistDataSynced", "showIndexHtmlAsView"],
  "hooks": ["taskComplete", "taskUpdate"],
  "iFrame": true,
  "sidePanel": true,
  "isSkipMenuEntry": false,
  "icon": "icon.svg"
}
