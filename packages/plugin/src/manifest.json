{
  "id": "questarc",
  "name": "QuestArc",
  "version": "3.1.0",
  "manifestVersion": 1,
  "minSupVersion": "19.3.0",
  "description": "Habits as journeys: walk a path of small habit steps, calm by default with an optional RPG layer.",
  "author": "nexumia",
  "hooks": [
    "dataChanged",
    "dayChange",
    "persistedDataChanged",
    "finishDay",
    "taskComplete",
    "taskUpdate",
    "taskDelete",
    "anyTaskUpdate"
  ],
  "permissions": [
    "getAppState",
    "getArchivedTasks",
    "getDayContext",
    "loadSyncedData",
    "listSyncedDataKeys",
    "persistDataSynced",
    "showSnack",
    "showIndexHtmlAsView",
    "addTask",
    "selectTask",
    "registerTaskContextMenuEntry"
  ],
  "dataSharing": [],
  "iFrame": true,
  "icon": "route"
}
