    "e2e:import": "node e2e/sp-import.mjs"
  },
  "dependencies": {
    "@questarc/engine": "*",
    "@questarc/ui": "*"
  },
  "devDependencies": {
    "@super-productivity/plugin-api": "20.0.0"
  }
}
