    },
    {
      "id": "b",
      "plan": { "anchor": "test-build.b.anchor", "action": "test-build.b.action" },
      "schedule": { "type": "daily" },
      "condition": { "type": "count", "n": 3 }
    },
    {
      "id": "c",
      "plan": { "anchor": "test-build.c.anchor", "action": "test-build.c.action" },
      "schedule": { "type": "daily" },
      "condition": { "type": "time_spent", "minutes": 30 }
    }
  ]
